{
  "name": "@atofinite5/sork-cli",
  "version": "1.3.0",
  "description": "Sorkcloud CLI — AI-powered security pipeline for Node.js projects. Scans, triages, fixes, verifies, and supports multiple AI agents (Claude, OpenAI, Codex, Gemini, Mistral, Llama). Works with BYOK or sorkcloud.space-managed keys.",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "sork": "dist/bin/sork.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "keywords": [
    "security",
    "orchestration",
    "remediation",
    "vulnerability-scanner",
    "ai",
    "byok",
    "auto-fix",
    "pre-commit",
    "prettier",
    "eslint",
    "zod",
    "code-quality",
    "devsecops"
  ],
  "author": "Bhargav Kalambhe",
  "license": "MIT",
  "homepage": "https://github.com/Atofinite5/SORK-Security-Orchestration-Remediation-Keeping-",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atofinite5/SORK-Security-Orchestration-Remediation-Keeping-.git"
  },
  "bugs": {
    "url": "https://github.com/Atofinite5/SORK-Security-Orchestration-Remediation-Keeping-/issues"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "rm -rf dist/",
    "start": "npm run build && node dist/bin/sork.js",
    "dev": "NODE_ENV=development npm run build && node dist/bin/sork.js",
    "test": "npm run build && node --test --test-reporter=spec dist/tests/**/*.test.js",
    "test:watch": "node --test --watch dist/tests/**/*.test.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "qa": "npm run format:check && npm run lint && npm run type-check",
    "qa:fix": "npm run format && npm run lint:fix && npm run type-check",
    "global": "npm run build && npm install -g .",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run qa && npm run build"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^6.10.0",
    "@typescript-eslint/types": "^6.21.0",
    "@typescript-eslint/typescript-estree": "^6.10.0",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1",
    "minimist": "^1.2.8",
    "openai": "^4.67.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint": "^8.50.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
